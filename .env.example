# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: model used for scoring jobs, writing cover letters and answering form questions.
# Defaults to claude-opus-5-5. Cheaper option for bulk scoring: claude-haiku-4-5
# CLAUDE_MODEL=claude-opus-5-5
# SCORE_MODEL=claude-haiku-4-5

# Optional: by default requests opt in to server-side model fallback (a safety refusal is retried on another
# model instead of failing). Set to "off" if your account or API platform rejects that beta.
# CLAUDE_FALLBACKS=off

# Optional: path to a Chromium/Chrome binary. Leave unset locally after `npx playwright install chromium`.
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
