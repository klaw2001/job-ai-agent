  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "commander": "^15.0.0",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
